# ====================================================
# 환경변수 설정 파일
# 이 파일을 복사하여 .env 로 저장 후 실제 키를 입력하세요
# cp .env.example .env
# ====================================================

# ── Claude API (Anthropic) ──
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Typecast TTS API ──
# https://typecast.ai 에서 발급
TYPECAST_API_KEY=your_typecast_api_key_here

# ── Typecast 기본 음성 ID ──
# Typecast 대시보드에서 원하는 음성 캐릭터의 ID를 복사하여 입력
TYPECAST_ACTOR_ID=your_actor_id_here

# ── 앱 설정 ──
OUTPUT_DIR=outputs           # 결과물 저장 경로
MAX_IMAGES=10                # 최대 업로드 이미지 수
